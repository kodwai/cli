{
  "name": "@kodwai/cli",
  "version": "1.10.0",
  "description": "Real coding challenges you solve with your own AI agent. kodwai scores how well you direct it: Direction, Outcome, Lift.",
  "homepage": "https://www.kodwai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodwai/cli.git"
  },
  "bugs": {
    "url": "https://github.com/kodwai/cli/issues"
  },
  "type": "module",
  "bin": {
    "kodwai": "dist/bin/kodwai.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "kodwai",
    "coding-challenge",
    "developer",
    "ai-agent",
    "interview",
    "hiring"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": false,
  "dependencies": {
    "chalk": "^5.4.0",
    "cross-spawn": "^7.0.6",
    "diff": "^7.0.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/diff": "^7.0.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
